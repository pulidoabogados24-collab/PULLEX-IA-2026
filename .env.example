# Copia este archivo como .env y completa tus datos.
# NO compartas el archivo .env ni lo subas a internet.

# Clave de la API de Claude (console.anthropic.com → API Keys). OBLIGATORIA.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxx

# Administrador (para entrar al panel /admin y activar cuentas de estudiantes).
# OBLIGATORIO: pon tu propia clave fuerte y aleatoria — nunca reutilices un valor de ejemplo.
# Sin PULLEX_ADMIN_CLAVE definida, la app se niega a arrancar (hallazgo de seguridad S1).
PULLEX_ADMIN_EMAIL=admin@pullex.co
PULLEX_ADMIN_CLAVE=pon-aqui-tu-propia-clave-fuerte-y-aleatoria

# Modelo del chat y del Laboratorio de casos. Por defecto Sonnet 5.5 (más preciso; ~3 veces el costo
# de Haiku por consulta, ver docs/11-MOTOR-DE-FUENTES.md). Para abaratar: claude-haiku-4-5
PULLEX_MODELO=claude-sonnet-5-5
# Esfuerzo del modelo (low, medium, high). Vacío = valor por defecto de la API. Haiku lo ignora.
# PULLEX_ESFUERZO=medium

# Proveedor de IA (docs/15-PLANES-Y-PROVEEDORES.md). Por defecto Anthropic (Claude).
# PULLEX_PROVEEDOR=anthropic          # anthropic | openai
# PULLEX_RESPALDO=openai              # opcional: se usa si el principal está saturado o caído
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx  # platform.openai.com → API keys (solo si usas openai)
# PULLEX_OPENAI_MODELO=gpt-6.1-sol    # gpt-6-luna abarata; gpt-6-astra es el más capaz
# PULLEX_OPENAI_ESFUERZO=medium       # vacío = no enviar reasoning.effort

# Correo al que escribe el botón «Mejorar plan» (por defecto, el de soporte).
# PULLEX_CONTACTO_PLANES=tucorreo@ejemplo.com

# Opcional: modelo del boletín diario (por defecto usa el mismo de arriba).
# PULLEX_MODELO_BOLETIN=claude-haiku-4-5

# Motor de fuentes (docs/11-MOTOR-DE-FUENTES.md). Índice del corpus propio:
# PULLEX_CORPUS_DB=corpus/corpus.db
# Búsqueda web del chat: solo dominios oficiales (lista por defecto en fuentes.py). "*" = sin restricción.
# PULLEX_WEB_DOMINIOS=corteconstitucional.gov.co,cortesuprema.gov.co,...
# PULLEX_WEB_MAX_USOS=5
# Biblioteca de modelos (docs/15-BIBLIOTECA.md). El material de TERCEROS queda restringido al administrador
# hasta que confirmes sus derechos de redistribución. Estas dos variables son decisiones del dueño:
# PULLEX_BIBLIOTECA_TERCEROS=general        # muestra a todos los usuarios las FICHAS del material de terceros
# PULLEX_BIBLIOTECA_TEXTO_TERCEROS=1        # muestra además su TEXTO (vista previa, extractos, copia con texto)
# PULLEX_BIBLIOTECA_DB=biblioteca/biblioteca.db
# Ingesta desde Google Drive (opcional): cuenta de servicio con acceso de lectura a LEXCOL_CORPUS.
# GOOGLE_SERVICE_ACCOUNT_JSON=/ruta/fuera/del/repo/llave.json
# DRIVE_FOLDER_ID=

# Clave para firmar las sesiones. OBLIGATORIA en Vercel y en Render: sin ella la app NO arranca (en Render
# render.yaml la genera sola; en Vercel defínela en Settings → Environment Variables). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Solo en local, sin ella la app crea un archivo app_secret.key (permisos 0600): quien tenga ese archivo puede
# entrar a cualquier cuenta, admin incluida. Nunca lo compartas, lo empaquetes en un zip ni lo subas a GitHub.
# PULLEX_SECRET=pon-aqui-un-texto-largo-secreto

# Exigir el correo verificado para usar las consultas (1 = sí). Por defecto 0: actívala solo cuando hayas
# comprobado que los correos de verificación llegan (RESEND_API_KEY y un remitente de tu dominio).
# PULLEX_EXIGIR_VERIFICACION=0

# Cuántos proxies propios hay delante de la app (para leer la IP real en X-Forwarded-For). Por defecto 1 en
# Vercel o Render y 0 en local (se usa la IP de la conexión). Cámbiala solo si agregas otro proxy (p. ej. Cloudflare).
# PULLEX_PROXIES_CONFIABLES=1

# Documentación automática de la API (/docs, /redoc, /openapi.json). Apagada por defecto; 1 solo en desarrollo.
# PULLEX_DOCS=0

# Opcional: si conectas el corpus vectorial de lexcol-rag.
# VOYAGE_API_KEY=pa-xxxxxxxxxxxx

# Correo saliente: verificación de cuenta y recuperación de contraseña de los estudiantes.
# Sin RESEND_API_KEY, la app sigue funcionando normal, pero esos correos no se envían
# (solo queda un aviso en el log del servidor) — no es obligatoria para arrancar.
# Consíguela gratis en https://resend.com (capa gratuita: 3.000 correos/mes).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
PULLEX_EMAIL_FROM=PULLEX IA <onboarding@resend.dev>

# URL pública de tu app (para armar los enlaces de los correos). En Render, la URL que te
# asigna tu servicio; en local, deja el valor por defecto.
PULLEX_APP_URL=http://localhost:8000
